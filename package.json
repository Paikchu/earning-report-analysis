{
  "name": "earning-report-analysis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:sec",
    "test:sec": "npm run build && node --experimental-strip-types --test tests/sec.test.ts tests/sec-analysis.test.ts tests/sec-v3.test.ts tests/sec-report.test.ts tests/sec-pipeline.test.ts tests/sec-workflow.test.ts tests/sec-d1.test.ts tests/sec-api.test.ts tests/sec-config.test.ts tests/sec-migration.test.ts tests/sec-public-api.test.ts tests/sec-whitelist.test.ts tests/sec-cron.test.ts tests/sec-operations.test.ts tests/sec-integration.test.ts && tsx --test tests/sec-report-render.test.tsx",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:local:apply": "npm run build && wrangler d1 migrations apply site-creator-d1 --local --persist-to .wrangler/state --config dist/server/wrangler.json",
    "sec-cron:check": "wrangler deploy --config workers/sec-cron/wrangler.jsonc --env=\"\" --dry-run",
    "sec-cron:deploy": "wrangler deploy --config workers/sec-cron/wrangler.jsonc --env=\"\" --keep-vars",
    "web:prepare": "node --experimental-strip-types scripts/prepare-web-worker.ts",
    "web:check": "node --experimental-strip-types scripts/check-web-worker-config.ts",
    "web:deploy": "npm run build && npm run web:prepare && npm run web:check && wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "migration:export": "node --experimental-strip-types scripts/export-sec-migration.ts",
    "migration:import": "node --experimental-strip-types scripts/import-sec-migration.ts",
    "migration:d1:prepare": "node --experimental-strip-types scripts/prepare-sec-d1-import.ts",
    "migration:r2:verify": "node --experimental-strip-types scripts/verify-r2-manifest.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "motion": "13.1.1",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
