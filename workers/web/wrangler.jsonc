{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "earning-report-analysis-sec-web",
  "main": "index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "ANALYSIS_SERVICE",
      "service": "earning-report-analysis-sec-pipeline"
    }
  ]
}
