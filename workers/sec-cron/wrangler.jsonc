{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "max-investment-record-sec-cron",
  "main": "index.ts",
  "compatibility_date": "2026-07-25",
  "vars": {
    "MAX_SITE_ORIGIN": "https://max-investment-record.max-zhangyuchen.chatgpt.site"
  },
  "triggers": {
    "crons": [
      "0 13-23 * * 1-5",
      "0 0-3 * * 2-6"
    ]
  },
  "observability": {
    "enabled": true
  }
}
