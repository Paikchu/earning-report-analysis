{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "earning-report-analysis-sec-pipeline",
  "main": "index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WEB_APP_ORIGIN": "https://earning-report-analysis-sec-web.max-zhangyuchen.workers.dev",
    "SEC_USER_AGENT": "earning-report-analysis/1.0 max.zhangyuchen@gmail.com",
    "SEC_ANALYSIS_MODEL": "glm-5.3-flash"
  },
  "workflows": [
    {
      "name": "earning-report-analysis-sec-analysis",
      "binding": "SEC_ANALYSIS_WORKFLOW",
      "class_name": "SecAnalysisWorkflow",
      "concurrency": {
        "limit": 4
      }
    },
    {
      "name": "earning-report-analysis-sec-memory",
      "binding": "SEC_MEMORY_WORKFLOW",
      "class_name": "SecMemoryWorkflow"
    },
    {
      "name": "earning-report-analysis-company-analysis",
      "binding": "COMPANY_ANALYSIS_WORKFLOW",
      "class_name": "CompanyAnalysisWorkflow",
      "concurrency": {
        "limit": 2
      }
    },
    {
      "name": "earning-report-analysis-company-analysis-backfill",
      "binding": "COMPANY_ANALYSIS_BACKFILL_WORKFLOW",
      "class_name": "CompanyAnalysisBackfillWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SEC_FILINGS",
      "bucket_name": "earning-report-analysis-sec-filings"
    }
  ],
  // The same database the Web Worker binds — this Worker writes it directly rather than asking the
  // Web Worker to write on its behalf. The id is an account-scoped identifier, not a credential,
  // and is committed here the way the bucket and Worker names above are; the Web Worker's config
  // carries a placeholder only because `vinext build` generates it. migrations_dir points at their
  // single source directory so worker:pipeline:check:migrations compares the same list Web applies.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earning-report-analysis-sec-web",
      "database_id": "3c917a4c-3562-4de1-8b21-586fa384e63f",
      "migrations_dir": "../web/migrations"
    }
  ],
  // The Web Worker's public hostname is unreachable from inside this Worker — two Workers on the
  // same workers.dev subdomain get a 404 from the edge before the request lands. Every bridge call
  // goes through this binding instead. Block comments would break check-config.ts, which strips
  // only whole-line // comments before parsing this file.
  "services": [
    { "binding": "WEB", "service": "earning-report-analysis-sec-web" }
  ],
  // TEMPORARY, while the dead scheduled refresh is being diagnosed: every 10 minutes around the
  // clock, so a failed run surfaces within minutes instead of at the next hourly slot. The market
  // windows this replaces cover 09:00-23:00 ET Mon-Fri and must go back once the run is healthy:
  //   "0 13-23 * * 1-5"
  //   "0 0-3 * * 2-6"
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "earning-report-analysis-sec-pipeline-staging",
      "vars": {
        "WEB_APP_ORIGIN": "https://earning-report-analysis-sec-web-staging.max-zhangyuchen.workers.dev",
        "SEC_USER_AGENT": "earning-report-analysis/1.0 max.zhangyuchen@gmail.com",
        "SEC_ANALYSIS_MODEL": "glm-5.3-flash"
      },
      "workflows": [
        {
          "name": "earning-report-analysis-sec-analysis-staging",
          "binding": "SEC_ANALYSIS_WORKFLOW",
          "class_name": "SecAnalysisWorkflow",
          "concurrency": {
            "limit": 4
          }
        },
        {
          "name": "earning-report-analysis-sec-memory-staging",
          "binding": "SEC_MEMORY_WORKFLOW",
          "class_name": "SecMemoryWorkflow"
        },
        {
          "name": "earning-report-analysis-company-analysis-staging",
          "binding": "COMPANY_ANALYSIS_WORKFLOW",
          "class_name": "CompanyAnalysisWorkflow",
          "concurrency": {
            "limit": 2
          }
        },
        {
          "name": "earning-report-analysis-company-analysis-backfill-staging",
          "binding": "COMPANY_ANALYSIS_BACKFILL_WORKFLOW",
          "class_name": "CompanyAnalysisBackfillWorkflow"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SEC_FILINGS",
          "bucket_name": "earning-report-analysis-sec-filings-staging"
        }
      ],
      // No D1 binding: staging must never write the production database, and it has no database of
      // its own yet. Its Cron list is empty, so nothing reaches the fundamentals sync on its own; a
      // canary that does gets the explicit "no D1 binding" error instead of a silent wrong write.
      "triggers": { "crons": [] }
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
